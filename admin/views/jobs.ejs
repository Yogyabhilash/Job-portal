<%- include('partials/header', { token: token, activePage: 'jobs' }) %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2 fw-bold text-dark">Job Postings Manager</h1>
  <div class="text-muted">Active job postings: <%= jobs.length %></div>
</div>

<div class="table-container">
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Job Title</th>
          <th>Company</th>
          <th>Location</th>
          <th>Salary</th>
          <th>Job Type</th>
          <th>Posted By</th>
          <th>Required Skills</th>
          <th class="text-center">Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (jobs.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center text-muted py-4">No job postings found.</td>
          </tr>
        <% } %>
        <% jobs.forEach(job => { %>
          <tr>
            <td>
              <div class="fw-semibold"><%= job.title %></div>
            </td>
            <td><%= job.company %></td>
            <td>
              <span class="text-secondary"><i class="bi bi-geo-alt me-1"></i><%= job.location %></span>
            </td>
            <td><%= job.salary %></td>
            <td>
              <span class="badge bg-secondary text-capitalize"><%= job.jobType %></span>
            </td>
            <td>
              <div><%= job.recruiter ? job.recruiter.name : 'Unknown Recruiter' %></div>
              <small class="text-muted"><%= job.recruiter ? job.recruiter.email : '' %></small>
            </td>
            <td>
              <% if (job.skills && job.skills.length > 0) { %>
                <div class="d-flex flex-wrap gap-1">
                  <% job.skills.forEach(skill => { %>
                    <span class="badge bg-light text-dark border"><%= skill %></span>
                  <% }) %>
                </div>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
            <td class="text-center">
              <form action="/admin/jobs/delete/<%= job._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this job posting? This action will delete the job and all related student applications, and cannot be undone.');" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-outline-danger fw-semibold">
                  <i class="bi bi-trash me-1"></i>Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer', { token: token }) %>
