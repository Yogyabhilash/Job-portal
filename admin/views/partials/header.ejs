<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - Job Portal</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <!-- Google Font Outfit -->
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary-color: #2563eb;
      --secondary-color: #4f46e5;
      --dark-color: #0f172a;
      --light-color: #f8fafc;
      --border-color: #e2e8f0;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background-color: #f1f5f9;
      color: #334155;
    }

    /* Admin Sidebar Layout */
    .sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 100;
      padding: 48px 0 0;
      box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
      width: 240px;
      background-color: var(--dark-color);
      color: white;
    }

    .sidebar-sticky {
      position: relative;
      top: 0;
      height: calc(100vh - 48px);
      padding-top: .5rem;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .sidebar .nav-link {
      font-weight: 500;
      color: #94a3b8;
      padding: 12px 24px;
      transition: all 0.3s;
    }

    .sidebar .nav-link:hover {
      color: white;
      background-color: rgba(255, 255, 255, 0.05);
    }

    .sidebar .nav-link.active {
      color: white;
      background-color: var(--primary-color);
    }

    .sidebar .nav-link i {
      margin-right: 8px;
    }

    .main-content {
      margin-left: 240px;
      padding: 40px;
    }

    /* Premium card design */
    .admin-card {
      background: white;
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .admin-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    .admin-nav {
      background-color: white;
      border-bottom: 1px solid var(--border-color);
    }

    .navbar-brand-custom {
      font-weight: 700;
      color: white;
      text-decoration: none;
      font-size: 1.5rem;
      padding: 20px 24px;
      display: block;
      background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .navbar-admin-title {
      font-weight: 700;
      color: white;
      padding: 20px 24px;
      display: block;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Table styles */
    .table-container {
      background: white;
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05);
      border: 1px solid var(--border-color);
    }

    .table th {
      font-weight: 600;
      color: #475569;
      border-bottom: 2px solid var(--border-color);
    }

    .table td {
      vertical-align: middle;
    }

    .badge-verified {
      background-color: #dcfce7;
      color: #166534;
      font-weight: 600;
    }

    .badge-unverified {
      background-color: #fee2e2;
      color: #991b1b;
      font-weight: 600;
    }
  </style>

  <!-- Client-Side JWT Propagator -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Get token from localStorage if not in URL, or update localStorage if in URL
      const urlParams = new URLSearchParams(window.location.search);
      let token = urlParams.get('token');
      
      if (token) {
        localStorage.setItem('admin_token', token);
      } else {
        token = localStorage.getItem('admin_token');
      }

      // If no token exists and we are not on the login page, redirect to login
      if (!token && !window.location.pathname.endsWith('/admin/login')) {
        window.location.href = '/admin/login?error=Please log in to access the admin portal.';
        return;
      }

      // If token exists, make sure it is appended to all admin navigation links
      if (token) {
        document.querySelectorAll('a').forEach(a => {
          try {
            const url = new URL(a.href, window.location.origin);
            if (url.pathname.startsWith('/admin') && !url.pathname.endsWith('/admin/login')) {
              url.searchParams.set('token', token);
              a.href = url.pathname + url.search + url.hash;
            }
          } catch (e) {
            // Ignore invalid/external URLs
          }
        });

        // Intercept all form submissions and append token
        document.querySelectorAll('form').forEach(form => {
          try {
            const url = new URL(form.action, window.location.origin);
            if (url.pathname.startsWith('/admin')) {
              url.searchParams.set('token', token);
              form.action = url.pathname + url.search + url.hash;

              // If it is a POST form, also add a hidden input field as a fallback
              if (form.method.toLowerCase() === 'post') {
                let hiddenInput = form.querySelector('input[name="token"]');
                if (!hiddenInput) {
                  hiddenInput = document.createElement('input');
                  hiddenInput.type = 'hidden';
                  hiddenInput.name = 'token';
                  form.appendChild(hiddenInput);
                }
                hiddenInput.value = token;
              }
            }
          } catch (e) {}
        });
      }
    });

    function logoutAdmin() {
      localStorage.removeItem('admin_token');
      window.location.href = '/admin/login';
    }
  </script>
</head>
<body>

  <% if (locals.token) { %>
    <!-- Sidebar -->
    <nav class="sidebar">
      <div class="sidebar-sticky">
        <div class="navbar-admin-title">
          <i class="bi bi-shield-lock-fill me-2"></i>Job Portal Admin
        </div>
        <ul class="nav flex-column mt-4">
          <li class="nav-item">
            <a class="nav-link <%= locals.activePage === 'dashboard' ? 'active' : '' %>" href="/admin/dashboard">
              <i class="bi bi-speedometer2"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.activePage === 'users' ? 'active' : '' %>" href="/admin/users">
              <i class="bi bi-people"></i> Users
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.activePage === 'recruiters' ? 'active' : '' %>" href="/admin/recruiters">
              <i class="bi bi-patch-check"></i> Recruiters
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.activePage === 'jobs' ? 'active' : '' %>" href="/admin/jobs">
              <i class="bi bi-briefcase"></i> Jobs
            </a>
          </li>
          <li class="nav-item mt-5">
            <a class="nav-link text-danger" href="javascript:void(0)" onclick="logoutAdmin()">
              <i class="bi bi-box-arrow-right"></i> Log Out
            </a>
          </li>
        </ul>
      </div>
    </nav>
    <div class="main-content">
  <% } %>
