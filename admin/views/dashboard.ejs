<%- include('partials/header', { token: token, activePage: 'dashboard' }) %>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2 fw-bold text-dark">Dashboard Overview</h1>
  <div class="text-muted">Logged in as Administrator</div>
</div>

<!-- Stats Section -->
<div class="row g-4 mt-2">
  <div class="col-md-3">
    <div class="card admin-card p-3 border-0 text-white bg-primary">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Total Students</h6>
          <h2 class="fw-bold mb-0"><%= stats.totalStudents %></h2>
        </div>
        <div class="fs-1"><i class="bi bi-people-fill"></i></div>
      </div>
    </div>
  </div>
  
  <div class="col-md-3">
    <div class="card admin-card p-3 border-0 text-white bg-success">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Total Recruiters</h6>
          <h2 class="fw-bold mb-0"><%= stats.totalRecruiters %></h2>
        </div>
        <div class="fs-1"><i class="bi bi-patch-check-fill"></i></div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card admin-card p-3 border-0 text-white bg-warning">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Total Jobs</h6>
          <h2 class="fw-bold mb-0"><%= stats.totalJobs %></h2>
        </div>
        <div class="fs-1"><i class="bi bi-briefcase-fill"></i></div>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card admin-card p-3 border-0 text-white bg-info">
      <div class="card-body d-flex align-items-center justify-content-between">
        <div>
          <h6 class="text-white-50 text-uppercase fw-semibold mb-1">Applications</h6>
          <h2 class="fw-bold mb-0"><%= stats.totalApplications %></h2>
        </div>
        <div class="fs-1"><i class="bi bi-file-earmark-text-fill"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Link Actions -->
<div class="row mt-5">
  <div class="col-md-6">
    <div class="card admin-card border-0 p-4">
      <h5 class="fw-bold mb-3"><i class="bi bi-gear-fill text-primary me-2"></i>Quick Tasks</h5>
      <p class="text-muted">Take immediate actions on pending moderation queue tasks.</p>
      <div class="d-grid gap-3">
        <a href="/admin/recruiters" class="btn btn-outline-primary text-start fw-semibold py-2">
          <i class="bi bi-patch-check me-2"></i>Verify Pending Recruiters
        </a>
        <a href="/admin/jobs" class="btn btn-outline-warning text-start fw-semibold py-2">
          <i class="bi bi-trash me-2"></i>Review Fake Job Postings
        </a>
        <a href="/admin/users" class="btn btn-outline-info text-start fw-semibold py-2">
          <i class="bi bi-people me-2"></i>Manage User Accounts
        </a>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card admin-card border-0 p-4 bg-dark text-white">
      <h5 class="fw-bold mb-3"><i class="bi bi-info-circle-fill text-warning me-2"></i>System Status</h5>
      <ul class="list-group list-group-flush bg-transparent">
        <li class="list-group-item bg-transparent text-white border-secondary px-0">
          <strong>Database:</strong> MongoDB Online
        </li>
        <li class="list-group-item bg-transparent text-white border-secondary px-0">
          <strong>Auth Mode:</strong> JWT Header & Query Params
        </li>
        <li class="list-group-item bg-transparent text-white border-secondary px-0">
          <strong>Security Hash:</strong> bcryptjs (2.4.3)
        </li>
        <li class="list-group-item bg-transparent text-white border-0 px-0">
          <strong>Node Environment:</strong> Development
        </li>
      </ul>
    </div>
  </div>
</div>

<%- include('partials/footer', { token: token }) %>
